# ==========================================
# CRITICAL: Required Environment Variables
# ==========================================

# JWT Secret - Generate with: openssl rand -base64 32
# NEVER use the same secret across environments
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET

# Database URL - PostgreSQL connection string
DATABASE_URL=postgresql://dsagent:your_password@localhost:5432/dsagent

# ==========================================
# Database Configuration (Docker Compose)
# ==========================================
POSTGRES_DB=dsagent
POSTGRES_USER=dsagent
POSTGRES_PASSWORD=your_secure_password_here

# ==========================================
# Server Configuration
# ==========================================
NODE_ENV=production
PORT=3000

# Tokenhaus Server URL (for MCP client to connect to)
TOKENHAUS_SERVER_URL=https://ds-agent.alpy.io

# Dashboard URL (for plugin browser-based auth)
DASHBOARD_URL=https://ds-agent.alpy.io

# CORS Configuration - Comma-separated list of allowed origins
CORS_ORIGIN=https://ds-agent.alpy.io,https://www.figma.com

# ==========================================
# Frontend URLs (for production build)
# ==========================================
VITE_API_URL=https://ds-agent.alpy.io/api
VITE_WS_URL=https://ds-agent.alpy.io

# ==========================================
# Optional: External Services
# ==========================================
# FIGMA_ACCESS_TOKEN=your_figma_token_here
